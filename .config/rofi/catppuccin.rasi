* {
    bg:      #1e1e2eee;
    bg2:     #313244cc;
    fg:      #cdd6f4;
    accent:  #cba6f7;
    muted:   #6c7086;

    background-color: transparent;
    text-color: @fg;
    border-color: @accent;
    outline-color: transparent;
}

window {
    background-color: @bg;
    border: 2px;
    border-radius: 16px;
    width: 520px;
    padding: 24px;
    location: center;
    x-offset: 0;
    y-offset: 0;
}

inputbar {
    background-color: @bg2;
    border-radius: 10px;
    padding: 12px 16px;
    margin: 0 0 16px 0;
    spacing: 10px;
    children: [prompt, entry];
}

prompt {
    text-color: @accent;
    font: "FiraCode Nerd Font 13";
}

entry {
    text-color: @fg;
    placeholder: "search apps...";
    placeholder-color: @muted;
    font: "FiraCode Nerd Font 13";
}

listview {
    lines: 6;
    columns: 1;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 10px 14px;
    border-radius: 8px;
    spacing: 12px;
    orientation: horizontal;
    children: [element-icon, element-text];
}

element normal normal {
    background-color: transparent;
    text-color: @fg;
}

element selected normal {
    background-color: @accent;
    text-color: #1e1e2e;
}

element-icon {
    size: 24px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    font: "FiraCode Nerd Font 13";
}
